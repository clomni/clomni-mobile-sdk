{
  "name": "@clomni/react-native",
  "version": "1.0.0",
  "description": "Clomni Messenger for React Native: the native iOS and Android SDKs behind one TypeScript API.",
  "license": "Apache-2.0",
  "homepage": "https://clomni.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clomni/clomni-mobile-sdk.git",
    "directory": "react-native"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "!src/__tests__",
    "lib",
    "android/build.gradle",
    "android/gradle.properties",
    "android/src",
    "ios",
    "clomni-react-native.podspec",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md",
    "app.plugin.js",
    "plugin",
    "!plugin/__tests__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "codegen": "node scripts/codegen.js",
    "prepack": "npm run build"
  },
  "codegenConfig": {
    "name": "ClomniSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "ai.clomni.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "Clomni": "RCTClomni"
      }
    }
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.75",
    "expo": ">=52"
  },
  "devDependencies": {
    "@expo/config-plugins": "~57.0.9",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "ts-jest": "^29.4.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  }
}
