<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The "İnternet yoxdur" strip of the open messenger. No other permission: the launcher lives in the app's own
         windows (no SYSTEM_ALERT_WINDOW), photos come from the Photo Picker, and the camera app takes a photo or a
         video for the messenger (an app that declares CAMERA itself is asked for it first). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <activity
            android:name="ai.clomni.messenger.ui.ClomniMessengerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:theme="@style/clomni_messenger"
            android:windowSoftInputMode="adjustResize" />

        <!-- A photo taken for a message: the camera app writes it here (the app's cache), for this one use. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.clomni.camera"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/clomni_camera_paths" />
        </provider>
    </application>

</manifest>
