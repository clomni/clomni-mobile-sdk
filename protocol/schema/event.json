{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.clomni.ai/protocol/v1/event.json",
  "title": "WebSocket frame",
  "description": "A frame the server sends on wss://…/v1/realtime: { event, data, ts }. ping has no data and is answered with pong (realtime-client.json). Messages are sent over REST; the socket only receives, apart from pong and typing. Unknown events are ignored by the client.",
  "type": "object",
  "required": ["event", "ts"],
  "properties": {
    "event": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" },
    "data": {},
    "ts": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "event": { "const": "ready" } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/ready" } } } },
    { "if": { "properties": { "event": { "enum": ["message.created", "message.updated"] } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "message.json" } } } },
    { "if": { "properties": { "event": { "const": "typing" } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/typing" } } } },
    { "if": { "properties": { "event": { "const": "read" } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/read" } } } },
    { "if": { "properties": { "event": { "const": "conversation.updated" } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/conversation_updated" } } } },
    { "if": { "properties": { "event": { "const": "unread.changed" } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/unread_changed" } } } },
    { "if": { "properties": { "event": { "const": "config.changed" } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/config_changed" } } } },
    { "if": { "properties": { "event": { "const": "flow.completed" } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/flow_completed" } } } }
  ],
  "$defs": {
    "conversation_id": { "type": "string", "pattern": "^conv_.+" },
    "ready": {
      "type": "object",
      "required": ["user_id", "heartbeat_sec"],
      "properties": {
        "user_id": { "type": "string", "pattern": "^usr_.+" },
        "heartbeat_sec": { "type": "integer", "minimum": 1 }
      }
    },
    "typing": {
      "type": "object",
      "required": ["conversation_id", "sender", "state"],
      "properties": {
        "conversation_id": { "$ref": "#/$defs/conversation_id" },
        "sender": { "$ref": "message.json#/$defs/sender" },
        "state": { "enum": ["on", "off"] }
      }
    },
    "read": {
      "type": "object",
      "required": ["conversation_id", "up_to_seq", "by"],
      "properties": {
        "conversation_id": { "$ref": "#/$defs/conversation_id" },
        "up_to_seq": { "type": "integer", "minimum": 0 },
        "by": { "enum": ["user", "operator"] }
      }
    },
    "conversation_updated": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/conversation_id" },
        "status": { "enum": ["bot", "queued", "open", "closed"] },
        "assignee": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "avatar_url": { "type": ["string", "null"], "format": "uri" }, "online": { "type": "boolean" } } }
          ]
        },
        "unread_count": { "type": "integer", "minimum": 0 },
        "flow": { "$ref": "#/$defs/conversation_flow" }
      }
    },
    "conversation_flow": {
      "description": "Whether a flow drives the conversation; always sent. The SDK goes by this alone: while active it hides the composer, unless awaiting is text. A flow that ended (with an END step or without), stopped because a person replied, or handed over is active: false, and the change arrives as conversation.updated.",
      "type": "object",
      "required": ["active", "awaiting"],
      "properties": {
        "active": { "type": "boolean" },
        "awaiting": { "enum": ["menu", "text", "form", null], "description": "menu: buttons (a language question too); text: typed text, the composer is shown; form: a form; null: nothing yet, e.g. a wait step, or the flow is inactive." },
        "flow_id": { "type": "string", "pattern": "^flw_.+", "description": "While active." },
        "node_id": { "type": "string", "description": "While active: the step it stands on." }
      }
    },
    "unread_changed": {
      "type": "object",
      "required": ["total"],
      "properties": { "total": { "type": "integer", "minimum": 0 } }
    },
    "config_changed": {
      "type": "object",
      "required": ["etag", "version"],
      "properties": {
        "etag": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 0, "description": "The published appearance version the config now has." }
      }
    },
    "flow_completed": {
      "type": "object",
      "description": "A flow has finished: end (it ran to its end, the conversation is closed) or handoff (a person or the assistant takes over). The SDKs call onFlowCompleted with it.",
      "required": ["conversation_id", "flow_id", "outcome"],
      "properties": {
        "conversation_id": { "$ref": "#/$defs/conversation_id" },
        "flow_id": { "type": "string", "pattern": "^flw_.+" },
        "outcome": { "enum": ["end", "handoff"] }
      }
    }
  }
}
