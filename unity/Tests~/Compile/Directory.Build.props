<Project>
  <!-- C# 9 and .NET Standard 2.1: what Unity 2021.3 compiles. Output goes to the temp directory, not the package. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$([System.IO.Path]::GetTempPath())clomni-unity-compile/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>$([System.IO.Path]::GetTempPath())clomni-unity-compile/$(MSBuildProjectName)/bin/</BaseOutputPath>
  </PropertyGroup>
</Project>
